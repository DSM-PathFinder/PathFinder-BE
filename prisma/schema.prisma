generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String   @default("")
  name        String
  plan        String   @default("Free Plan")
  bio         String?  @db.Text
  provider    String   @default("local")
  providerId  String?
  streak      Int      @default(0)
  lastActiveAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roadmaps    Roadmap[]
  notes       Note[]
  likes       Like[]
}

model Roadmap {
  id        String   @id @default(uuid())
  title     String
  goal      String   @db.Text
  category  String   @default("Frontend") // Frontend | Backend | AI/ML | Data | DevOps
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  weeks     Week[]
  likes     Like[]
}

model Week {
  id             String   @id @default(uuid())
  weekNumber     Int
  theme          String
  description    String   @db.Text
  estimatedHours Int      @default(0)
  actualHours    Int      @default(0)   // 실제 학습 시간 (태스크 완료 시 누적)

  roadmap        Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  roadmapId      String

  tasks          Task[]
  resources      Resource[]
}

model Task {
  id          String    @id @default(uuid())
  title       String
  completed   Boolean   @default(false)
  completedAt DateTime?

  week        Week      @relation(fields: [weekId], references: [id], onDelete: Cascade)
  weekId      String

  notes       Note[]
}

model Resource {
  id     String @id @default(uuid())
  title  String
  url    String @default("#")
  type   String @default("doc")

  week   Week   @relation(fields: [weekId], references: [id], onDelete: Cascade)
  weekId String
}

model Note {
  id        String   @id @default(uuid())
  title     String
  content   String?  @db.LongText
  weekId    String?

  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  taskId    String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Like {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  roadmap   Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  roadmapId String

  @@unique([userId, roadmapId])
}
